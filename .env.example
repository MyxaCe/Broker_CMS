# ─────────────────────────────────────────────────────────────────────────────
# Broker CMS v2 — переменные окружения
#
# Все переменные ниже ОБЯЗАТЕЛЬНЫ, кроме LOG_LEVEL. Отсутствие или пустое
# значение любой из них означает, что процесс не стартует (fail-closed,
# ТЗ разд. 3 и 6). Проверка — src/platform/config/env.ts.
#
# Значения ниже — рабочие для локального контура: они совпадают с
# docker-compose.dev.yml, включая смещённые порты (Postgres 5433, Redis 6380,
# RabbitMQ 5673). `cp .env.example .env` обязан давать работающую установку —
# файл, требующий ручной правки перед первым запуском, её не даёт.
#
# Ни одно из них не секрет: контур поднимается на машине разработчика и никуда
# не смотрит. Настоящие секреты живут вне репозитория (ТЗ разд. 6).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# trace | debug | info | warn | error | fatal — единственное поле с умолчанием (info)
LOG_LEVEL=debug

# Публичный адрес приложения (админка и API доставки)
APP_PUBLIC_URL=http://localhost:3001

# ── Хранилища ────────────────────────────────────────────────────────────────
# Порты смещены относительно стандартных: на машине может стоять свой Postgres.
DATABASE_URL=postgres://cms:dev_only_not_a_secret@localhost:5433/broker_cms_v2
REDIS_URL=redis://localhost:6380

# ── Шина событий (ТЗ 3.5) ────────────────────────────────────────────────────
# vhost задаётся в docker-compose.dev.yml — значение ниже совпадает с ним
BUS_URL=amqp://cms:dev_only_not_a_secret@localhost:5673/platform
BUS_EXCHANGE=platform.events

# ── Медиа (ТЗ 5.3) ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=broker-cms-media
S3_ACCESS_KEY_ID=cms_dev_access_key
S3_SECRET_ACCESS_KEY=dev_only_not_a_secret_32_chars_min
# ВАЖНО: обязан отличаться по origin от APP_PUBLIC_URL — пользовательские файлы
# раздаются с отдельного домена, иначе загрузка файла даёт XSS в origin админки.
# 9000 — раздача MinIO; 9001 — веб-консоль, файлы с неё не отдаются.
MEDIA_PUBLIC_URL=http://localhost:9000

# ── Внешние системы ──────────────────────────────────────────────────────────
MDS_HTTP_URL=http://localhost:3003
SENTRY_DSN=https://dev-placeholder@localhost/0

# ── Секреты приложения (минимум 32 символа каждый) ───────────────────────────
PAYLOAD_SECRET=dev_only_payload_secret_32_chars_min
PREVIEW_SECRET=dev_only_preview_secret_32_chars_min
DELIVERY_KEY_PEPPER=dev_only_delivery_pepper_32_chars_min

# ── Режим витрины торговых условий (ADR-0004, ADR-0005) ──────────────────────
# core       — источник истины торговое ядро, работает воркер сверки
# unverified — ядра ещё нет: значения подтверждает compliance, выдача помечается
#              "verified": false, обязательна дата пересмотра
# Умолчания нет намеренно: ослабленный режим выбирается явно.
TRADING_TERMS_MODE=unverified
