{
  "name": "broker-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Broker CMS v2 — источник истины для контента, дизайна и клиентской конфигурации сайтов брокерской платформы.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "generate:importmap": "node --env-file-if-exists=.env ./node_modules/payload/bin.js generate:importmap",
    "generate:types": "node --env-file-if-exists=.env ./node_modules/payload/bin.js generate:types",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "payload": "node --env-file=.env ./node_modules/payload/bin.js",
    "migrate": "node --env-file=.env ./node_modules/payload/bin.js migrate",
    "migrate:create": "node scripts/migrate-create.mjs",
    "migrate:down": "node --env-file-if-exists=.env ./node_modules/payload/bin.js migrate:down",
    "migrate:status": "node --env-file=.env ./node_modules/payload/bin.js migrate:status",
    "worker:outbox": "node --env-file=.env ./node_modules/payload/bin.js run src/workers/publish-outbox.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "migrate:test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/payload/bin.js migrate",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "ajv": "^8",
    "ajv-formats": "^3",
    "amqplib": "^2.0.1",
    "graphql": "^16.8.1",
    "ioredis": "^5",
    "next": "16.2.12",
    "payload": "3.86.0",
    "pino": "^9.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^7",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3",
      "postcss": "^8.5.25",
      "dompurify": "^3.4.12",
      "brace-expansion": "^5.0.9",
      "esbuild": "^0.25.12",
      "undici": "^7.29.0",
      "fast-uri": "^3.1.5"
    }
  }
}
